@model User
@{
    ViewData["Title"] = "User Profile";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Taxpayer Profile</h3>
        <p class="text-muted mb-0 small">Personal details, permanent account credentials and contact info</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="section-card">
            <div class="section-card-header bg-light">
                <h5 class="mb-0 text-primary"><i class="bi bi-person-badge-fill me-2"></i>Personal & Account Information</h5>
            </div>
            <div class="section-card-body p-4">
                <dl class="row mb-0 g-3">
                    <dt class="col-sm-4 text-muted">Full Name</dt>
                    <dd class="col-sm-8 fw-semibold fs-5 text-dark mb-0">@Model.FullName</dd>

                    <dt class="col-sm-4 text-muted">PAN Number</dt>
                    <dd class="col-sm-8 mb-0"><span class="badge bg-dark font-monospace fs-6 px-3 py-2">@Model.PAN</span></dd>

                    <dt class="col-sm-4 text-muted">Email Address</dt>
                    <dd class="col-sm-8 mb-0">@Model.Email</dd>

                    <dt class="col-sm-4 text-muted">Mobile Number</dt>
                    <dd class="col-sm-8 mb-0">@Model.Mobile</dd>

                    <dt class="col-sm-4 text-muted">Date of Birth</dt>
                    <dd class="col-sm-8 mb-0">@Model.DateOfBirth.ToString("dd MMMM yyyy")</dd>

                    <dt class="col-sm-4 text-muted">Residential Address</dt>
                    <dd class="col-sm-8 mb-0">@(string.IsNullOrWhiteSpace(Model.Address) ? "Not provided" : Model.Address)</dd>

                    <dt class="col-sm-4 text-muted">Account Role</dt>
                    <dd class="col-sm-8 mb-0"><span class="badge bg-primary">@Model.Role</span></dd>

                    <dt class="col-sm-4 text-muted">Account Status</dt>
                    <dd class="col-sm-8 mb-0"><span class="badge bg-success">@Model.Status</span></dd>

                    <dt class="col-sm-4 text-muted">Registration Date</dt>
                    <dd class="col-sm-8 mb-0">@Model.CreatedDate.ToString("f")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
