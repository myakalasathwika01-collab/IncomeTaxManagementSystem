@model IEnumerable<Document>
@{
    ViewData["Title"] = "Documents";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">My Documents</h3>
        <p class="text-muted mb-0 small">Uploaded tax proofs, Form 16, and supporting records</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
    </a>
</div>

<div class="section-card">
    <div class="section-card-header">
        <h5><i class="bi bi-folder2-open me-2 text-primary"></i>Uploaded Tax Documents</h5>
    </div>
    <div class="section-card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Document Type</th>
                            <th>File Name</th>
                            <th>Uploaded Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@doc.DocumentType</td>
                                <td><code>@doc.FileName</code></td>
                                <td class="small text-muted">@doc.UploadedDate.ToString("dd MMM yyyy HH:mm")</td>
                                <td><span class="badge bg-warning text-dark">@doc.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-cloud-arrow-up text-muted" style="font-size: 3rem;"></i>
                <h6 class="text-muted fw-semibold mt-3">No documents uploaded yet.</h6>
                <p class="small text-muted mb-0">Document upload module will be available in the upcoming phase.</p>
            </div>
        }
    </div>
</div>
