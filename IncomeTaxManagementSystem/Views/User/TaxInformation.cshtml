@model IEnumerable<TaxDetails>
@{
    ViewData["Title"] = "Tax Information";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Tax Information</h3>
        <p class="text-muted mb-0 small">Review and manage your annual income, deductions and tax regime</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
    </a>
</div>

<div class="section-card">
    <div class="section-card-header d-flex justify-content-between align-items-center">
        <h5><i class="bi bi-receipt me-2 text-primary"></i>Assessment Year Records</h5>
    </div>
    <div class="section-card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Assessment Year</th>
                            <th>Employment Type</th>
                            <th>Employer</th>
                            <th>Gross Salary</th>
                            <th>Other Income</th>
                            <th>TDS</th>
                            <th>Deductions</th>
                            <th>Regime</th>
                            <th>Added Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.AssessmentYear</td>
                                <td>@item.EmploymentType</td>
                                <td>@(string.IsNullOrWhiteSpace(item.EmployerName) ? "—" : item.EmployerName)</td>
                                <td class="font-monospace text-success">₹ @item.GrossSalary.ToString("N2")</td>
                                <td class="font-monospace">₹ @item.OtherIncome.ToString("N2")</td>
                                <td class="font-monospace">₹ @item.TDS.ToString("N2")</td>
                                <td class="font-monospace text-danger">₹ @item.Deductions.ToString("N2")</td>
                                <td><span class="badge bg-primary">@item.TaxRegime</span></td>
                                <td class="small text-muted">@item.CreatedDate.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-file-earmark-spreadsheet text-muted" style="font-size: 3rem;"></i>
                <h6 class="text-muted fw-semibold mt-3">No tax information added yet.</h6>
                <p class="small text-muted mb-0">Detailed tax filing records will appear here once submitted.</p>
            </div>
        }
    </div>
</div>
