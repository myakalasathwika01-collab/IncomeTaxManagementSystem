@model UserDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var user = Model.User;
    var tax = Model.LatestTaxDetails;
    var app = Model.LatestApplication;
}

<!-- Top Welcome Section with Tax Illustration -->
<div class="dashboard-hero-card">
    <div class="row align-items-center">
        <div class="col-lg-8 mb-3 mb-lg-0">
            <div class="hero-welcome-badge">
                <i class="bi bi-shield-lock-fill"></i> Verified Taxpayer Portal
            </div>
            <h1 class="hero-title">Welcome back, @user.FullName!</h1>
            <p class="hero-subtitle">
                Manage your income tax information, documents and application status from one place.
            </p>

            <div class="hero-meta-badges">
                <div class="hero-meta-item">
                    <span class="text-white-50">PAN:</span>
                    <strong class="font-monospace text-white">@user.PAN</strong>
                </div>
                <div class="hero-meta-item">
                    <span class="text-white-50">Account Status:</span>
                    <span class="badge @(Model.AccountStatus == "Active" ? "bg-success" : "bg-warning")">
                        @Model.AccountStatus
                    </span>
                </div>
                <div class="hero-meta-item">
                    <span class="text-white-50">Email:</span>
                    <span class="text-white">@user.Email</span>
                </div>
            </div>
        </div>

        <div class="col-lg-4 text-center">
            <div class="hero-visual-wrapper">
                <img src="~/images/tax-dashboard.svg" alt="Income Tax Filing Illustration" class="img-fluid" />
            </div>
        </div>
    </div>
</div>

<!-- 4 Key Metric Stat Cards (Real Values from SQL Server) -->
<div class="row g-3 mb-4">
    <!-- Account Status Card -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">ACCOUNT STATUS</span>
                <div class="stat-icon-badge stat-icon-success">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
            </div>
            <div>
                <div class="stat-value text-success">@Model.AccountStatus</div>
                <div class="stat-footer-text">Member since @user.CreatedDate.ToString("dd MMM yyyy")</div>
            </div>
        </div>
    </div>

    <!-- Tax Information Card -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">TAX INFORMATION</span>
                <div class="stat-icon-badge @(Model.HasTaxDetails ? "stat-icon-primary" : "stat-icon-warning")">
                    <i class="bi bi-calculator"></i>
                </div>
            </div>
            <div>
                <div class="stat-value @(Model.HasTaxDetails ? "text-primary" : "text-warning")">
                    @Model.TaxStatusText
                </div>
                <div class="stat-footer-text">
                    @(Model.HasTaxDetails ? $"AY: {tax!.AssessmentYear}" : "Assessment year pending")
                </div>
            </div>
        </div>
    </div>

    <!-- Documents Card -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">DOCUMENTS</span>
                <div class="stat-icon-badge stat-icon-info">
                    <i class="bi bi-folder2-open"></i>
                </div>
            </div>
            <div>
                <div class="stat-value text-info">@Model.DocumentStatusText</div>
                <div class="stat-footer-text">Supporting tax records</div>
            </div>
        </div>
    </div>

    <!-- Application Status Card -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">APPLICATION</span>
                <div class="stat-icon-badge @(Model.HasApplication ? "stat-icon-primary" : "stat-icon-info")">
                    <i class="bi bi-card-checklist"></i>
                </div>
            </div>
            <div>
                <div class="stat-value text-primary">@Model.ApplicationStatusText</div>
                <div class="stat-footer-text">
                    @(Model.HasApplication ? $"App #{app!.ApplicationNumber}" : "Filing not started")
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions Section -->
<div class="mb-4">
    <h5 class="fw-bold mb-3 text-secondary"><i class="bi bi-lightning-charge-fill text-warning me-2"></i>Quick Actions</h5>
    <div class="row g-3">
        <div class="col-6 col-md-3">
            <a asp-action="Profile" class="quick-action-btn">
                <i class="bi bi-person-check-fill btn-icon"></i>
                <span>Complete Profile</span>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-action="TaxInformation" class="quick-action-btn">
                <i class="bi bi-plus-circle-fill btn-icon"></i>
                <span>Add Tax Information</span>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-action="Documents" class="quick-action-btn">
                <i class="bi bi-cloud-arrow-up-fill btn-icon"></i>
                <span>Upload Documents</span>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-action="Applications" class="quick-action-btn">
                <i class="bi bi-file-earmark-text-fill btn-icon"></i>
                <span>View Application</span>
            </a>
        </div>
    </div>
</div>

<!-- Application Progress Tracker Component -->
<div class="progress-tracker-card">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="fw-bold mb-0"><i class="bi bi-signpost-split me-2 text-primary"></i>Application Progress</h5>
        <span class="badge bg-light text-dark border">
            Step @Model.ProgressStep of 7
        </span>
    </div>
    <p class="text-muted small mb-0">Track each stage of your Income Tax return submission</p>

    <div class="progress-tracker-steps">
        <!-- 1. Registration -->
        <div class="tracker-step @(Model.ProgressStep >= 1 ? "completed" : "")">
            <div class="tracker-step-circle">
                <i class="bi bi-check-lg"></i>
            </div>
            <div class="tracker-step-label">Registration</div>
        </div>

        <!-- 2. Profile Completed -->
        <div class="tracker-step @(Model.ProgressStep > 2 ? "completed" : (Model.ProgressStep == 2 ? "completed" : "current"))">
            <div class="tracker-step-circle">
                @if (Model.IsProfileComplete)
                {
                    <i class="bi bi-check-lg"></i>
                }
                else
                {
                    <span>2</span>
                }
            </div>
            <div class="tracker-step-label">Profile Completed</div>
        </div>

        <!-- 3. Tax Details Added -->
        <div class="tracker-step @(Model.HasTaxDetails ? "completed" : (Model.ProgressStep == 2 ? "current" : ""))">
            <div class="tracker-step-circle">
                @if (Model.HasTaxDetails)
                {
                    <i class="bi bi-check-lg"></i>
                }
                else
                {
                    <span>3</span>
                }
            </div>
            <div class="tracker-step-label">Tax Details Added</div>
        </div>

        <!-- 4. Documents Uploaded -->
        <div class="tracker-step @(Model.TotalDocuments > 0 ? "completed" : (Model.HasTaxDetails ? "current" : ""))">
            <div class="tracker-step-circle">
                @if (Model.TotalDocuments > 0)
                {
                    <i class="bi bi-check-lg"></i>
                }
                else
                {
                    <span>4</span>
                }
            </div>
            <div class="tracker-step-label">Documents Uploaded</div>
        </div>

        <!-- 5. Application Submitted -->
        <div class="tracker-step @(app != null && app.SubmittedDate.HasValue ? "completed" : "")">
            <div class="tracker-step-circle">
                @if (app != null && app.SubmittedDate.HasValue)
                {
                    <i class="bi bi-check-lg"></i>
                }
                else
                {
                    <span>5</span>
                }
            </div>
            <div class="tracker-step-label">Submitted</div>
        </div>

        <!-- 6. Admin Review -->
        <div class="tracker-step @(app != null && app.ReviewedDate.HasValue ? "completed" : "")">
            <div class="tracker-step-circle">
                @if (app != null && app.ReviewedDate.HasValue)
                {
                    <i class="bi bi-check-lg"></i>
                }
                else
                {
                    <span>6</span>
                }
            </div>
            <div class="tracker-step-label">Admin Review</div>
        </div>

        <!-- 7. Approved -->
        <div class="tracker-step @(app != null && string.Equals(app.Status, "Approved", StringComparison.OrdinalIgnoreCase) ? "completed" : "")">
            <div class="tracker-step-circle">
                @if (app != null && string.Equals(app.Status, "Approved", StringComparison.OrdinalIgnoreCase))
                {
                    <i class="bi bi-check-lg"></i>
                }
                else
                {
                    <span>7</span>
                }
            </div>
            <div class="tracker-step-label">Approved</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Tax Information Summary Section -->
    <div class="col-lg-8">
        <div class="section-card h-100 mb-0">
            <div class="section-card-header">
                <h5><i class="bi bi-journal-text me-2 text-primary"></i>Tax Information Summary</h5>
                @if (Model.HasTaxDetails)
                {
                    <a asp-action="TaxInformation" class="btn btn-sm btn-outline-primary">View Full Details</a>
                }
            </div>
            <div class="section-card-body">
                @if (Model.HasTaxDetails && tax != null)
                {
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle mb-0">
                            <tbody>
                                <tr>
                                    <th class="bg-light text-muted w-25">Assessment Year</th>
                                    <td class="fw-semibold">@tax.AssessmentYear</td>
                                    <th class="bg-light text-muted w-25">Tax Regime</th>
                                    <td><span class="badge bg-primary">@tax.TaxRegime</span></td>
                                </tr>
                                <tr>
                                    <th class="bg-light text-muted">Employment Type</th>
                                    <td>@tax.EmploymentType</td>
                                    <th class="bg-light text-muted">Employer Name</th>
                                    <td>@(string.IsNullOrWhiteSpace(tax.EmployerName) ? "—" : tax.EmployerName)</td>
                                </tr>
                                <tr>
                                    <th class="bg-light text-muted">Gross Salary</th>
                                    <td class="font-monospace text-success fw-bold">₹ @tax.GrossSalary.ToString("N2")</td>
                                    <th class="bg-light text-muted">Other Income</th>
                                    <td class="font-monospace">₹ @tax.OtherIncome.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <th class="bg-light text-muted">TDS Deducted</th>
                                    <td class="font-monospace">₹ @tax.TDS.ToString("N2")</td>
                                    <th class="bg-light text-muted">Deductions</th>
                                    <td class="font-monospace text-danger">₹ @tax.Deductions.ToString("N2")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <div class="text-muted mb-3">
                            <i class="bi bi-receipt text-secondary" style="font-size: 3rem;"></i>
                        </div>
                        <h6 class="text-muted fw-semibold">No tax information added yet.</h6>
                        <p class="small text-muted mb-3">Provide your income details and deductions to initiate your tax filing.</p>
                        <a asp-action="TaxInformation" class="btn btn-primary btn-sm px-3">
                            <i class="bi bi-plus-lg me-1"></i> Add Tax Information
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Tax Filing CTA Visual Card -->
    <div class="col-lg-4">
        <div class="section-card h-100 mb-0">
            <div class="section-card-header">
                <h5><i class="bi bi-file-earmark-check me-2 text-primary"></i>Tax Filing</h5>
            </div>
            <div class="section-card-body d-flex flex-column justify-content-between text-center">
                <div class="py-2">
                    <div class="mb-3">
                        <div class="d-inline-flex p-3 bg-light rounded-circle border">
                            <i class="bi bi-calculator-fill text-primary" style="font-size: 2.5rem;"></i>
                        </div>
                    </div>
                    <h6 class="fw-bold mb-2">Annual Income Tax Return</h6>
                    <p class="text-muted small mb-3">
                        Keep your income tax information organized and ready for submission.
                    </p>
                </div>
                <div>
                    <a asp-action="TaxInformation" class="btn btn-outline-primary w-100 fw-semibold">
                        Manage Tax Information
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
