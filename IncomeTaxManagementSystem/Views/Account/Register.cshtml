@model RegisterViewModel
@{
    ViewData["Title"] = "User Registration";
}

<div class="row justify-content-center my-4">
    <div class="col-lg-8 col-md-10">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 text-center"><i class="bi bi-person-plus-fill me-2"></i>User Registration</h4>
                <p class="mb-0 text-center small text-white-50">Create your Income Tax Management System account</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Register" asp-controller="Account" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="FullName" class="form-control" placeholder="Enter your full name" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PAN" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="PAN" class="form-control text-uppercase" placeholder="e.g. ABCDE1234F" maxlength="10" />
                            <span asp-validation-for="PAN" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="DateOfBirth" class="form-control" type="date" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Mobile" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="Mobile" class="form-control" placeholder="10-digit mobile number" maxlength="10" />
                            <span asp-validation-for="Mobile" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Email" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="Email" class="form-control" type="email" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="Password" class="form-control" type="password" placeholder="At least 6 characters" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Re-enter password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-semibold"></label>
                            <textarea asp-for="Address" class="form-control" rows="3" placeholder="Enter your residential address"></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary btn-lg fw-bold">REGISTER</button>
                    </div>

                    <hr class="my-4" />

                    <div class="text-center">
                        <p class="mb-0 text-muted">Already registered? <a asp-action="Login" asp-controller="Account" class="text-primary fw-bold text-decoration-none">LOGIN</a></p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
