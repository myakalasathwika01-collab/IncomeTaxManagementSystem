<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IncomeTax Management System</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Custom Styles -->
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IncomeTaxManagementSystem.styles.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        var userName = User.Identity.Name ?? "User";
        var userInitial = !string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "U";
        var isAdmin = User.IsInRole("Admin");

        <div class="app-wrapper">
            <!-- Mobile Sidebar Backdrop -->
            <div id="sidebarBackdrop" class="sidebar-backdrop"></div>

            <!-- Left Dark Sidebar -->
            <aside id="appSidebar" class="app-sidebar" aria-label="Sidebar Navigation">
                <!-- Sidebar Header / Brand -->
                <div class="sidebar-header">
                    <a asp-controller="@(isAdmin ? "Admin" : "User")" asp-action="Index" class="sidebar-brand">
                        <div class="brand-icon-wrapper">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div class="brand-text">
                            <span class="brand-title">IncomeTax</span>
                            <span class="brand-subtitle">Portal</span>
                        </div>
                    </a>
                    <button type="button" id="sidebarPinBtn" class="sidebar-toggle-pin d-none d-lg-flex" aria-label="Collapse Sidebar" title="Collapse Sidebar">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                </div>

                <!-- Sidebar Nav Menu -->
                <nav class="sidebar-nav">
                    @if (isAdmin)
                    {
                        <!-- Admin Navigation -->
                        <div class="nav-section-title">ADMINISTRATION</div>
                        <ul class="sidebar-menu">
                            <li class="sidebar-item @(currentController == "Admin" && currentAction == "Index" ? "active" : "")">
                                <a asp-controller="Admin" asp-action="Index" class="sidebar-link" title="Dashboard">
                                    <i class="bi bi-speedometer2 menu-icon"></i>
                                    <span class="menu-title">Admin Dashboard</span>
                                </a>
                            </li>
                            <li class="sidebar-item @(currentController == "Admin" && currentAction == "Users" ? "active" : "")">
                                <a asp-controller="Admin" asp-action="Users" class="sidebar-link" title="Users">
                                    <i class="bi bi-people menu-icon"></i>
                                    <span class="menu-title">Users</span>
                                </a>
                            </li>
                            <li class="sidebar-item @(currentController == "Admin" && currentAction == "Applications" ? "active" : "")">
                                <a asp-controller="Admin" asp-action="Applications" class="sidebar-link" title="Applications">
                                    <i class="bi bi-card-checklist menu-icon"></i>
                                    <span class="menu-title">Applications</span>
                                </a>
                            </li>
                            <li class="sidebar-item @(currentController == "Admin" && currentAction == "Documents" ? "active" : "")">
                                <a asp-controller="Admin" asp-action="Documents" class="sidebar-link" title="Documents">
                                    <i class="bi bi-folder2-open menu-icon"></i>
                                    <span class="menu-title">Documents</span>
                                </a>
                            </li>
                            <li class="sidebar-item @(currentController == "Admin" && currentAction == "Reports" ? "active" : "")">
                                <a asp-controller="Admin" asp-action="Reports" class="sidebar-link" title="Reports">
                                    <i class="bi bi-bar-chart-line menu-icon"></i>
                                    <span class="menu-title">Reports</span>
                                </a>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <!-- User Navigation -->
                        <div class="nav-section-title">MAIN MENU</div>
                        <ul class="sidebar-menu">
                            <li class="sidebar-item @(currentController == "User" && currentAction == "Index" ? "active" : "")">
                                <a asp-controller="User" asp-action="Index" class="sidebar-link" title="Dashboard">
                                    <i class="bi bi-grid-1x2 menu-icon"></i>
                                    <span class="menu-title">Dashboard</span>
                                </a>
                            </li>
                            <li class="sidebar-item @(currentController == "User" && currentAction == "Profile" ? "active" : "")">
                                <a asp-controller="User" asp-action="Profile" class="sidebar-link" title="Profile">
                                    <i class="bi bi-person-circle menu-icon"></i>
                                    <span class="menu-title">Profile</span>
                                </a>
                            </li>
                            <li class="sidebar-item @(currentController == "User" && currentAction == "TaxInformation" ? "active" : "")">
                                <a asp-controller="User" asp-action="TaxInformation" class="sidebar-link" title="Tax Information">
                                    <i class="bi bi-receipt-cutoff menu-icon"></i>
                                    <span class="menu-title">Tax Information</span>
                                </a>
                            </li>
                            <li class="sidebar-item @(currentController == "User" && currentAction == "Documents" ? "active" : "")">
                                <a asp-controller="User" asp-action="Documents" class="sidebar-link" title="Documents">
                                    <i class="bi bi-folder2-open menu-icon"></i>
                                    <span class="menu-title">Documents</span>
                                </a>
                            </li>
                            <li class="sidebar-item @(currentController == "User" && currentAction == "Applications" ? "active" : "")">
                                <a asp-controller="User" asp-action="Applications" class="sidebar-link" title="Applications">
                                    <i class="bi bi-file-earmark-text menu-icon"></i>
                                    <span class="menu-title">Applications</span>
                                </a>
                            </li>
                        </ul>

                        <div class="nav-section-title">TAX SERVICES</div>
                        <ul class="sidebar-menu">
                            <li class="sidebar-item">
                                <a asp-controller="User" asp-action="TaxInformation" class="sidebar-link" title="Income Details">
                                    <i class="bi bi-wallet2 menu-icon"></i>
                                    <span class="menu-title">Income Details</span>
                                </a>
                            </li>
                            <li class="sidebar-item">
                                <a asp-controller="User" asp-action="TaxInformation" class="sidebar-link" title="Deductions">
                                    <i class="bi bi-percent menu-icon"></i>
                                    <span class="menu-title">Deductions</span>
                                </a>
                            </li>
                            <li class="sidebar-item">
                                <a asp-controller="User" asp-action="Documents" class="sidebar-link" title="Tax Documents">
                                    <i class="bi bi-file-earmark-arrow-up menu-icon"></i>
                                    <span class="menu-title">Tax Documents</span>
                                </a>
                            </li>
                            <li class="sidebar-item">
                                <a asp-controller="User" asp-action="Applications" class="sidebar-link" title="Application Status">
                                    <i class="bi bi-clock-history menu-icon"></i>
                                    <span class="menu-title">Application Status</span>
                                </a>
                            </li>
                        </ul>
                    }
                </nav>

                <!-- Sidebar Footer -->
                <div class="sidebar-footer">
                    <div class="sidebar-user-card">
                        <div class="user-avatar-circle">
                            @userInitial
                        </div>
                        <div class="user-meta-info">
                            <div class="user-meta-name" title="@userName">@userName</div>
                            <div class="user-meta-role">@(isAdmin ? "Administrator" : "Taxpayer")</div>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- Main Workspace Container -->
            <div class="app-main">
                <!-- Top Header -->
                <header class="app-topbar">
                    <div class="topbar-left">
                        <button type="button" id="sidebarToggleBtn" class="topbar-toggle-btn" aria-label="Toggle Sidebar">
                            <i class="bi bi-list"></i>
                        </button>
                        <div class="page-breadcrumb">
                            <span class="text-muted">Portal</span>
                            <span class="text-muted">/</span>
                            <span class="current-page">@ViewData["Title"]</span>
                        </div>
                    </div>

                    <div class="topbar-right">
                        <!-- Notifications Dropdown -->
                        <div class="dropdown">
                            <button class="notification-btn" type="button" id="notifDropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
                                <i class="bi bi-bell"></i>
                                <span class="notification-badge-dot"></span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 py-2" aria-labelledby="notifDropdown" style="min-width: 260px;">
                                <li class="px-3 py-2 border-bottom fw-bold small text-muted">NOTIFICATIONS</li>
                                <li>
                                    <a class="dropdown-item py-2 d-flex align-items-center gap-2 small" href="#">
                                        <i class="bi bi-info-circle text-primary"></i>
                                        <span>Welcome to Income Tax Portal</span>
                                    </a>
                                </li>
                                <li class="text-center pt-2">
                                    <span class="text-muted small">No other pending alerts</span>
                                </li>
                            </ul>
                        </div>

                        <!-- User Profile Dropdown -->
                        <div class="dropdown topbar-user-dropdown">
                            <a href="#" class="dropdown-toggle" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="avatar-circle-sm">@userInitial</div>
                                <span class="d-none d-md-inline fw-semibold small">@userName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 py-2" aria-labelledby="userMenuDropdown" style="min-width: 200px;">
                                <li class="px-3 py-2 border-bottom">
                                    <div class="fw-bold small">@userName</div>
                                    <div class="text-muted smaller">Role: @(isAdmin ? "Admin" : "User")</div>
                                </li>
                                @if (!isAdmin)
                                {
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="User" asp-action="Profile">
                                            <i class="bi bi-person me-2 text-primary"></i>Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="User" asp-action="TaxInformation">
                                            <i class="bi bi-receipt me-2 text-primary"></i>Tax Information
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Index">
                                            <i class="bi bi-speedometer2 me-2 text-primary"></i>Admin Portal
                                        </a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100 text-start py-1">
                                            <i class="bi bi-box-arrow-right me-2"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <!-- Page Main Content Area -->
                <main role="main" class="app-content">
                    @RenderBody()
                </main>

                <!-- Footer -->
                <footer class="app-footer">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                        <span>&copy; 2026 <strong>Income Tax Management System</strong>. All rights reserved.</span>
                        <span class="text-muted small">Government of India Standard Compliance</span>
                    </div>
                </footer>
            </div>
        </div>
    }
    else
    {
        <!-- Public Layout for Unauthenticated Visitors (Login, Register, Home) -->
        <header>
            <nav class="navbar navbar-expand-md navbar-dark bg-dark border-bottom shadow-sm">
                <div class="container">
                    <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-shield-check text-primary fs-4"></i>
                        <span>IncomeTax Management</span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav" aria-controls="publicNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="publicNav">
                        <ul class="navbar-nav ms-auto align-items-center">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item ms-md-2">
                                <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item ms-2">
                                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <div class="container py-4">
            <main role="main">
                @RenderBody()
            </main>
        </div>

        <footer class="border-top py-3 text-center text-muted small bg-white mt-auto">
            <div class="container">
                &copy; 2026 - IncomeTaxManagementSystem - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>
    }

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/sidebar.js" asp-append-version="true"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
