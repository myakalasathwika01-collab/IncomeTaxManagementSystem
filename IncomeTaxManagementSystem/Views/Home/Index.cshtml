@{
    ViewData["Title"] = "Dashboard";
}

<script>
    // Client-side fallback redirect to dashboard
    window.location.replace('@(User.IsInRole("Admin") ? Url.Action("Index", "Admin") : Url.Action("Index", "User"))');
</script>

<div class="text-center py-5">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading Dashboard...</span>
    </div>
    <p class="text-muted mt-3">Redirecting to your dashboard...</p>
</div>
