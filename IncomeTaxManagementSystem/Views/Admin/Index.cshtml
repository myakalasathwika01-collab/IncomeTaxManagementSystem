@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-4">
    <div class="card bg-dark text-white border-0 shadow-sm p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold mb-1">Admin Portal</h2>
                <p class="text-white-50 mb-0">System Administrator Control Panel</p>
            </div>
            <div>
                <span class="badge bg-danger fs-6 px-3 py-2">Role: Admin</span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100 p-3">
                <div class="card-body">
                    <h5 class="text-muted">Registered Users</h5>
                    <h2 class="fw-bold text-primary mb-3">@ViewBag.UserCount</h2>
                    <a asp-action="Users" class="btn btn-primary">Manage Users</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100 p-3">
                <div class="card-body">
                    <h5 class="text-muted">Tax Applications</h5>
                    <h2 class="fw-bold text-success mb-3">@ViewBag.ApplicationCount</h2>
                    <a asp-action="Applications" class="btn btn-success">View Applications</a>
                </div>
            </div>
        </div>
    </div>
</div>
