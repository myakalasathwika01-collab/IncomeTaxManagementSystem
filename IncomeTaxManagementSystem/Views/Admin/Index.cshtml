@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="dashboard-hero-card mb-4">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <div class="hero-welcome-badge">
                <i class="bi bi-shield-lock-fill"></i> Central Administrative Console
            </div>
            <h1 class="hero-title">Welcome, Administrator</h1>
            <p class="hero-subtitle mb-0">
                Monitor taxpayer registrations, verify uploaded documents, and oversee income tax return processing across the system.
            </p>
        </div>
        <div class="col-lg-4 text-center d-none d-lg-block">
            <div class="d-inline-flex p-4 rounded-circle bg-white bg-opacity-10 border border-white border-opacity-20">
                <i class="bi bi-shield-check text-info" style="font-size: 3.5rem;"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">REGISTERED TAXPAYERS</span>
                <div class="stat-icon-badge stat-icon-primary">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
            <div>
                <div class="stat-value text-primary">@ViewBag.UserCount</div>
                <div class="stat-footer-text">Total registered users in system</div>
            </div>
            <div class="mt-3">
                <a asp-action="Users" class="btn btn-sm btn-outline-primary w-100">
                    <i class="bi bi-person-gear me-1"></i> Manage Users
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">TAX APPLICATIONS</span>
                <div class="stat-icon-badge stat-icon-success">
                    <i class="bi bi-card-checklist"></i>
                </div>
            </div>
            <div>
                <div class="stat-value text-success">@ViewBag.ApplicationCount</div>
                <div class="stat-footer-text">Tax returns filed for review</div>
            </div>
            <div class="mt-3">
                <a asp-action="Applications" class="btn btn-sm btn-outline-success w-100">
                    <i class="bi bi-eye me-1"></i> Review Applications
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-card-title">DOCUMENT ARCHIVE</span>
                <div class="stat-icon-badge stat-icon-info">
                    <i class="bi bi-folder2-open"></i>
                </div>
            </div>
            <div>
                <div class="stat-value text-info">@ViewBag.DocumentCount</div>
                <div class="stat-footer-text">Uploaded tax verification files</div>
            </div>
            <div class="mt-3">
                <a asp-action="Documents" class="btn btn-sm btn-outline-info w-100">
                    <i class="bi bi-file-earmark-check me-1"></i> Audit Documents
                </a>
            </div>
        </div>
    </div>
</div>
