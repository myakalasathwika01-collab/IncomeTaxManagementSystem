@model IEnumerable<Document>
@{
    ViewData["Title"] = "Tax Documents - Admin";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">User Tax Documents</h3>
        <p class="text-muted mb-0 small">Review uploaded verification documents submitted by taxpayers</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Admin Dashboard
    </a>
</div>

<div class="section-card">
    <div class="section-card-header">
        <h5><i class="bi bi-folder2-open me-2 text-primary"></i>All Documents</h5>
    </div>
    <div class="section-card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Id</th>
                            <th>Applicant</th>
                            <th>Document Type</th>
                            <th>File Name</th>
                            <th>Uploaded Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model)
                        {
                            <tr>
                                <td>@doc.Id</td>
                                <td class="fw-semibold">@doc.User?.FullName (<code>@doc.User?.PAN</code>)</td>
                                <td>@doc.DocumentType</td>
                                <td><code>@doc.FileName</code></td>
                                <td class="small text-muted">@doc.UploadedDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><span class="badge bg-warning text-dark">@doc.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-folder-x text-muted" style="font-size: 3rem;"></i>
                <h6 class="text-muted fw-semibold mt-3">No taxpayer documents submitted yet.</h6>
                <p class="small text-muted mb-0">Uploaded records will be listed here for administrative audit.</p>
            </div>
        }
    </div>
</div>
